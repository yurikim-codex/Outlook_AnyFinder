{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutLook AnyFinder",
  "version": "1.0.0",
  "identifier": "com.sesung.outlook-anyfinder",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OutLook AnyFinder",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/sidecar/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../tools/sign-one.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installerHooks": "nsis/hooks.nsi",
        "startMenuFolder": "OutLook AnyFinder",
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yurikim-codex/Outlook_AnyFinder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREM0JEQTFENjI4RjRFRTcKUldUblRvOWlIZG83VGVkaGVrbUdESm1yaTJYU0x4ZnViZWtHSWVJN1JSV29QaWkvaXBWVXpneVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
